# ---------------------------------------------------------------------------
# 運営側の入口（ハードコードせず、ここで指定する）
# ---------------------------------------------------------------------------
# 秘匿パスで運用する場合（例: https://example.com/k3n9x2）
OPS_BASE_PATH=k3n9x2
# ランダムなサブドメインで運用する場合はこちらを設定する（設定すると秘匿パスは無効）
# OPS_HOST=k3n9x2.example.com
# 1 にすると運営側の入口を閉じる。公開側だけをデプロイし、運営は手元のPCで行う構成で使う
# OPS_DISABLED=1

# ログインを許可するメールアドレス（カンマ区切り）
OPS_ALLOWED_EMAILS=you@example.com
# ローカル開発用のパスワード。Supabase Auth を設定した場合は使われない
OPS_DEV_PASSWORD=change-me
# セッション・確認コード・署名付きURLの鍵（本番では必ずランダムな値にする）
# 作り方の例: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
OPS_SESSION_SECRET=
DOWNLOAD_SIGNING_SECRET=

# ---------------------------------------------------------------------------
# 出品者（フェーズ1は1人）。初回の値としてだけ使い、あとはセットアップ画面で変える
# ---------------------------------------------------------------------------
CREATOR_DISPLAY_NAME=運営
# GitHubユーザー名。既定の置換ルールとNGワードに使う（公開側には出さない）
CREATOR_GITHUB_LOGIN=

# ---------------------------------------------------------------------------
# Supabase（未設定ならローカルのJSONファイルで動く）
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ZIP と画像・動画は Supabase Storage に置く（R2 を設定した場合は R2）。
# バケットは初回に非公開で自動作成される。名前を変えたいときだけ指定する（既定: showcase）
# SUPABASE_STORAGE_BUCKET=showcase

# ---------------------------------------------------------------------------
# ここから下は、運営側の「セットアップ」画面からも設定できる（画面の設定が優先）。
# 画面で保存した値はDBに入り、公開側にもそのまま反映される。ここに書くのは任意。
# ---------------------------------------------------------------------------
# SITE_NAME=リポジトリショーケース
# SITE_URL=https://your-site.netlify.app
# RESEND_API_KEY=re_...
# MAIL_FROM=講座サポート <no-reply@example.com>
# GITHUB_TOKEN=github_pat_...
# VIEWER_SESSION_DAYS=30
# DOWNLOAD_URL_TTL_SECONDS=600
# DOWNLOAD_RATE_LIMIT_PER_HOUR=5

# ---------------------------------------------------------------------------
# Cloudflare R2（未設定ならローカルのファイルシステムで動く）
# ---------------------------------------------------------------------------
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# GitHub App（未設定なら fixtures/repos をリポジトリとして扱う）
# 権限は Contents: 読み取り と Metadata: 読み取り だけにする
# ---------------------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=
# 個人トークンを使う場合は、セットアップ画面から入れる（上の GITHUB_TOKEN でも可）

# ローカル代替のデータ置き場
LOCAL_DATA_DIR=.data
LOCAL_REPOS_DIR=fixtures/repos
