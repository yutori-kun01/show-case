# ---------------------------------------------------------------------------
# 運営側の入口（ハードコードせず、ここで指定する）
# ---------------------------------------------------------------------------
# 秘匿パスで運用する場合（例: https://example.com/k3n9x2）
OPS_BASE_PATH=k3n9x2
# ランダムなサブドメインで運用する場合はこちらを設定する（設定すると秘匿パスは無効）
# OPS_HOST=k3n9x2.example.com

# ログインを許可するメールアドレス（カンマ区切り）
OPS_ALLOWED_EMAILS=you@example.com
# ローカル開発用のパスワード。Supabase Auth を設定した場合は使われない
OPS_DEV_PASSWORD=change-me
# セッションと署名付きURLの鍵（本番では必ずランダムな値にする）
OPS_SESSION_SECRET=
DOWNLOAD_SIGNING_SECRET=

# ---------------------------------------------------------------------------
# 出品者（フェーズ1は1人）
# ---------------------------------------------------------------------------
CREATOR_DISPLAY_NAME=運営
# GitHubユーザー名。既定の置換ルールとNGワードに使う（公開側には出さない）
CREATOR_GITHUB_LOGIN=

# ---------------------------------------------------------------------------
# Supabase（未設定ならローカルのJSONファイルで動く）
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Cloudflare R2（未設定ならローカルのファイルシステムで動く）
# ---------------------------------------------------------------------------
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# GitHub App（未設定なら fixtures/repos をリポジトリとして扱う）
# 権限は Contents: 読み取り と Metadata: 読み取り だけにする
# ---------------------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=
# 個人トークンで試す場合のみ
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# ダウンロード
# ---------------------------------------------------------------------------
DOWNLOAD_URL_TTL_SECONDS=600
DOWNLOAD_RATE_LIMIT_PER_HOUR=5

# ローカル代替のデータ置き場
LOCAL_DATA_DIR=.data
LOCAL_REPOS_DIR=fixtures/repos
